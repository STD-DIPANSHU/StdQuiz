{
  "name": "QuizBot",
  "description": "Telegram Quiz Bot with MongoDB",
  "repository": "https://github.com/yourname/quizbot",
  "keywords": ["telegram", "bot", "quiz", "mongodb"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from BotFather",
      "value": ""
    },
    "MONGO_URL": {
      "description": "MongoDB connection string (MongoDB Atlas or mLab)",
      "value": "mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "free"
    }
  },
  "addons": []
}
